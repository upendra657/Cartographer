# ==============================================================================
# Cartographer Gitignore Policy
# ==============================================================================

# Data & Datasets (Raw data and Parquet extracts)
Datasets/
data/
*.parquet
*.csv
!seeds/*.csv
!app/cache/*.parquet

# Secrets, Credentials & Local Config
.env
.env.*
profiles.yml
*.pem
*.key
.user.yml

# Python, Virtual Environments & Caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# dbt Artifacts & Logs
target/
dbt_packages/
logs/

# IDE, OS & Editor Temp Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Internal Agent Framework & Session Recovery
AGENTS.md
GEMINI.md
Resume context.md
OPERATING SYSTEM.md
